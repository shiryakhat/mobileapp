# ── App (Expo) ────────────────────────────────────────────────────────────────
# Copy to `.env`. Everything here is optional: the app launches with zero config.

# Community layer (auth, cloud bookmarks, minute comments, questions).
# Stays OFF until a Supabase project is provisioned (see supabase/README.md).
EXPO_PUBLIC_COMMUNITY_ENABLED=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Pipeline (Node, never bundled into the app) ──────────────────────────────
# Only needed for `npm run enrich` inside ./pipeline
ANTHROPIC_API_KEY=
# Optional overrides
# SYK_CORPUS_DIR=/Volumes/Beezhan/data/podcasts
# SYK_WEBSITE_DIR=./pipeline/.cache/website
# SYK_ENRICH_MODEL=claude-sonnet-4-6
